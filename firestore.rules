rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for sode_data collection
    match /sode_data/{document} {
      // Anyone can read the website data (modules, speakers, events, blogs, media, flyers)
      allow read: if true;
      
      // Only authenticated users with admin/superadmin roles can write to the website data
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }
    
    // Rules for adminMeta collection
    match /adminMeta/{userId} {
      // Authenticated users can read their own metadata document, if needed
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // No client is allowed to write directly to adminMeta. Writes must go through 
      // Cloud Functions (which use Admin SDK and bypass these rules).
      allow write: if false;
    }
  }
}
