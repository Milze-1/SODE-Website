rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sode-uploads/{allPaths=**} {
      // Anyone can read uploaded images (needed for public website)
      allow read: if true;
      
      // Only authenticated admins/superadmins can write uploads
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }
  }
}
